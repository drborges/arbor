{
  "compilerOptions": {
    "removeComments": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "CommonJS",
    "target": "ES2020",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "experimentalDecorators": true,
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react",
    "typeRoots": ["./node_modules/@types"],
    "types": []
  },
  "include": ["**/*.ts", "**/*.d.ts"],
  "exclude": ["examples"]
}
